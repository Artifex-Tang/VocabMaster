# 复制为 .deploy.env 并填真值。.deploy.env 已 gitignore，不入库。
# 部署目标
DEPLOY_HOST=your.server.ip
DEPLOY_USER=root
DEPLOY_PWD=your-ssh-password
DEPLOY_REMOTE_DIR=/opt/vocabmaster

# 生产应用凭据（写入服务器 /opt/vocabmaster/.env）
DB_ROOT_PASSWORD=
DB_NAME=vocabmaster
DB_USERNAME=vocab
DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
AES_KEY=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
