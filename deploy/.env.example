# ══════════════════════════════════════════════════
# VocabMaster 环境变量配置
# 复制为 .env 后修改：cp .env.example .env
# ══════════════════════════════════════════════════

# ── 数据库 ──
DB_ROOT_PASSWORD=root_secure_pwd_here
DB_NAME=vocabmaster
DB_USERNAME=vocab
DB_PASSWORD=vocab_secure_pwd_here

# ── Redis ──
REDIS_PASSWORD=redis_secure_pwd_here

# ── JWT (必须改，至少 32 字符) ──
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars

# ── AES 加密 key (Base64, 32 bytes) ──
AES_KEY=ZGV2LWFlcy1rZXktMzJieXRlcy1sb25n

# ── 微信小程序 (暂不用可留空) ──
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ── 端口 (一般不用改) ──
MYSQL_PORT=3306
REDIS_PORT=6379
BACKEND_PORT=8080

# ── JVM 参数 (2C2G 优化值，一般不用改) ──
# JAVA_OPTS=-Xmx384m -Xms256m -XX:+UseSerialGC -XX:+UseCompressedOops
