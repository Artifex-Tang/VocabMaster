    "@vue/test-utils": "^2.4.10",
    "happy-dom": "^20.9.0",
    "jest": "^30.4.2",
    "miniprogram-automator": "^0.12.1",
    "playwright": "^1.60.0",
    "sass-embedded": "^1.100.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vitest": "^3.2.6",
    "vue-tsc": "^2.0.6"
